DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
# -----------------------------------------------------------------------------
# Déploiement (Railway, Render, Fly.io, VPS…)
# -----------------------------------------------------------------------------
# Définir toutes ces variables sur l’hébergeur (pas besoin de fichier .env en prod).
#
# Démarrez avec : Dockerfile dans backend/ (voir Dockerfile ; migrations au boot).
# Healthcheck HTTP : GET /api/health
#
# Après le 1er déploiement, créez un admin une fois :
#   npx prisma migrate deploy   # déjà lancé au démarrage Docker si vous utilisez l’image
#   npm run seed:admin          # en local avec DATABASE_URL pointant la prod, ou équivalent CI
#
PORT=3000
JWT_ACCESS_SECRET="change-me-access-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# CORS : origine du front (Vite local + Netlify en prod). Sur Render, mettre l’URL Netlify réelle,
# sinon le navigateur bloque (preflight). Plusieurs origines : séparer par une virgule.
# Exemple prod : FRONTEND_URL=https://gestionavicole.netlify.app
# Local + prod sur la même API : https://gestionavicole.netlify.app,http://localhost:5173
FRONTEND_URL="http://localhost:5173"
ADMIN_PHONE="770000000"
ADMIN_EMAIL=""
ADMIN_PASSWORD="Admin123456"
